# Sime local environment example
# Copy service-specific values into backend/.env, frontend/.env.local, and worker/.env as needed.
# Do not commit real secrets.

# Docker Compose database defaults
POSTGRES_USER=app_backend
POSTGRES_PASSWORD=sime_dev_password
POSTGRES_DB=sime_db
POSTGRES_PORT=5432
REDIS_PORT=6379
WORKER_API_PORT=8000

# Shared local ports
BACKEND_PORT=4000
FRONTEND_PORT=3000
LANDING_PORT=8080

# Frontend -> backend
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:4000

# Backend service
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
FRONTEND_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
DATABASE_URL=postgresql://app_backend:CHANGE_ME@localhost:5432/sime_db?schema=public
REDIS_URL=redis://localhost:6379

# Auth and worker shared secret values must be set locally.
JWT_SECRET=
WORKER_SHARED_SECRET=

# LLM providers. Set real keys only in local .env files.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_OUTPUT_TOKENS=512
GEMINI_API_KEY=
GEMINI_TIMEOUT_MS=15000

# Worker pitch analysis
PITCH_MODEL=auto
DEVICE=auto
POLL_TIMEOUT=5
SWIFTF0_CONFIDENCE=0.9
RMVPE_MODEL_PATH=
RMVPE_THRESHOLD=0.03

