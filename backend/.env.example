# Server
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of trusted reverse-proxy hops. Keep 0 for direct/local backend access.
TRUST_PROXY_HOPS=0

# Comma-separated list of allowed frontend origins (CORS allowlist)
FRONTEND_ORIGIN=http://localhost:3000

# Python AI service base URL (pitch / range / tone analysis)
AI_SERVICE_URL=http://localhost:8000

# Data services (used when persistence and AI queues are implemented)
DATABASE_URL=postgresql://app_backend:CHANGE_ME@localhost:5432/sime_db?schema=public
REDIS_URL=redis://localhost:6379

# LLM coaching integration
GEMINI_API_KEY=
GEMINI_TIMEOUT_MS=15000

# Shared bearer token used only by Python AI workers when reporting job results.
WORKER_SHARED_SECRET=

# Auth secret. Register/login return 503 until this is set.
# Use a random 32+ character string.
JWT_SECRET=

# OpenAI coaching integration (primary LLM provider)
# Paste your real key into backend/.env only; never commit secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_MS=15000
OPENAI_MAX_OUTPUT_TOKENS=512
