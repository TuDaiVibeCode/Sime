# Copy to worker/.env and fill in. REDIS_URL and WORKER_SHARED_SECRET must match
# the values in backend/.env.

REDIS_URL=redis://localhost:6379
BACKEND_URL=http://localhost:4000

# Must be the SAME value as WORKER_SHARED_SECRET in backend/.env (min 32 chars).
WORKER_SHARED_SECRET=

# Pitch model: auto | pyin | crepe | swiftf0 | rmvpe
# auto/pyin run on CPU with no extra install. crepe needs torch + torchcrepe.
PITCH_MODEL=auto

# auto | cuda | cpu (only used by GPU models like crepe)
DEVICE=auto

# Seconds to block on the Redis queue per loop.
POLL_TIMEOUT=5

# SwiftF0 voicing confidence cutoff (0..1, higher = stricter).
SWIFTF0_CONFIDENCE=0.9

# RMVPE: absolute path to a downloaded rmvpe.pt (leave empty to disable; rmvpe
# requests then fall back to pYIN). RMVPE_THRESHOLD is its voicing cutoff.
RMVPE_MODEL_PATH=
RMVPE_THRESHOLD=0.03
